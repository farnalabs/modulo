MODULO_DB_PASSWORD=changeme
MODULO_PUBLIC_URL=http://localhost:80
MODULO_LOG_LEVEL=info
MODULO_SECRET_KEY=change-me-in-production
TAG=latest

# ---------------------------------------------------------------------------
# Redis — required for production (SAQ broker + rate limiting + caches)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://default:CHANGEME@host.upstash.io:6379

# ---------------------------------------------------------------------------
# SAQ (Celery migration) — plan F4 Settings section
# ---------------------------------------------------------------------------
# Tri-role SAQ_ENABLED: (1) dispatch routing, (2) dispatcher-column write,
# (3) Celery beat fire gate. The flag does NOT stop the SAQ workers.
# SAQ_ENABLED=false on production until PR C cutover.
# SAQ_ENABLED=false
# Claim staleness for SAQ runs only (legacy Celery path keeps today's 180s).
# RUN_CLAIM_STALE_SECONDS=450
# Legacy Celery-path claim window (today's `interval '3 minutes'` = 180s).
# LEGACY_RUN_CLAIM_STALE_SECONDS=180
# SAQ job heartbeat knob.
# SAQ_JOB_HEARTBEAT=300
# DB heartbeat cadence (keep well below the 300s SAQ sweep threshold).
# RUN_HEARTBEAT_SECONDS=30
# Cutover hold gate — healthz/ready 503 gating while SAQ_ENABLED=true during the hold.
# SAQ_HARD_GATE=true
# Web UI auth — FAIL-CLOSED (system worker refuses to boot without both).
# Provision via `fly secrets set` on all three Fly apps; staging BEFORE the
# PR B smoke. SAQ_AUTH_USERNAME maps to the AUTH_USER env SAQ's web reads.
# SAQ_AUTH_PASSWORD=changeme
# SAQ_AUTH_USERNAME=admin
# SAQ retries=N is N TOTAL attempts (N-1 retries). Set at PR C from the PR A
# E2B baseline; 5 unless the measured p99.5 demands more.
# SAQ_RUN_RETRIES=5
# Deterministic fixed retry delay (retry_backoff=False).
# SAQ_RETRY_DELAY=60
# Per-claim E2B idempotency key run:{id}:e2b:{claim_token}.
# SAQ_E2B_IDEMPOTENCY=true
# TEST-ONLY — refused when combined with SAQ_ENABLED=true outside test/staging.
# SAQ_TEST_PAUSE=false
# Legacy sweep windows match today's beat-sweep values (5 min / 10 min);
# re-enqueue is SAQ-only. Decoupled from RUN_CLAIM_STALE_SECONDS=450 (SAQ runs only).
# SAQ_REENQUEUE_WINDOW=600
# SAQ_NEVER_DISPATCHED_WINDOW=300
# SAQ_WORKER_LOST_WINDOW=600
# SAQ worker Postgres pool size (per worker).
# SAQ_WORKER_DB_POOL_SIZE=2
# SAQ Redis client pool size (Upstash connection budget).
# SAQ_REDIS_POOL_SIZE=5
