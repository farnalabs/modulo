# ---------------------------------------------------------------------------
# Environment file for deploy/compose/docker-compose.prod.yml
#
# Compose reads `.env` from the PROJECT DIRECTORY - the directory holding the
# compose file - so copy this file there before bringing the stack up:
#
#     cp .env.prod.example deploy/compose/.env
#     docker compose -f deploy/compose/docker-compose.prod.yml up -d
#
# The copy alone is not enough: fill in the five REQUIRED values below
# (MODULO_DB_PASSWORD, SECRET_KEY, FERNET_KEY, SAQ_AUTH_USERNAME,
# SAQ_AUTH_PASSWORD) before `up`, because compose refuses to start without
# them - it names the missing variable instead of substituting a default.
#
# Variable NAMES here and in the compose file are the names the application
# actually reads: a `Settings` field in backend/src/modulo/settings.py
# (`secret_key` -> `SECRET_KEY`, or the field's alias) or a name read directly
# from os.environ. A name nothing reads is silently ignored - that is exactly
# how MODULO_SECRET_KEY / MODULO_REDIS_URL shipped and a fresh deployment
# crash-looped at boot (FAR-1506). The contract is enforced by
# backend/tests/architecture/test_prod_compose_env_contract.py.
#
# SECRET_KEY, FERNET_KEY, MODULO_DB_PASSWORD, SAQ_AUTH_USERNAME and
# SAQ_AUTH_PASSWORD have NO default: the compose refuses to start (fail-fast,
# naming the variable) until all five are set below. Generate them as the
# comments on each entry say.
# ---------------------------------------------------------------------------

# Postgres password - REQUIRED. Used by the `postgres` service and embedded in
# the app's DATABASE_URL / DATABASE_ADMIN_URL, so it must be the password the
# database was actually initialised with. There is no default any more: compose
# used to fall back to the public string `changeme`, which meant an unset value
# silently shipped a production stack with a known password.
#   MODULO_DB_PASSWORD=$(openssl rand -hex 24)
# (hex is URL-safe, so it embeds in the DB URLs unchanged)
# Upgrading a stack that ran on the old default? Set MODULO_DB_PASSWORD=changeme
# to match the already-initialised volume, then rotate it with
# `ALTER ROLE modulo ...` / `ALTER ROLE modulo_app ...` and update this file.
# This one value also builds DATABASE_URL, DATABASE_ADMIN_URL and (in
# deploy/compose/docker-compose.prod.yml) MODULO_SYSTEM_DATABASE_URL - the
# compose interpolates it; there is no separate variable to set.
MODULO_DB_PASSWORD=

# Public base URL of this deployment (SSO redirects, absolute links).
MODULO_PUBLIC_URL=http://localhost:80
MODULO_LOG_LEVEL=info

# Image tag published by .github/workflows/publish-images.yml.
TAG=latest

# ---------------------------------------------------------------------------
# REQUIRED - JWT signing secret (Settings.secret_key).
# At least 32 random bytes; placeholder values are rejected at boot.
#   SECRET_KEY=$(openssl rand -base64 48)
# or, without openssl:
#   SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(48))")
# ---------------------------------------------------------------------------
SECRET_KEY=

# ---------------------------------------------------------------------------
# REQUIRED - Fernet key (Settings.fernet_key) encrypting stored connector and
# model-backend credentials. Settings only checks that it is >= 32 bytes, but
# cryptography's Fernet then requires 32 url-safe-base64-encoded bytes: a hex
# string or a shorter value boots fine and then fails on first credential use.
# Generate it with (canonical):
#   FERNET_KEY=$(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# `openssl rand -base64 32` also produces a key Fernet accepts (verified
# against cryptography); `openssl rand -hex 32` does NOT.
# ---------------------------------------------------------------------------
FERNET_KEY=

# First admin login (optional but recommended - otherwise no user exists and
# the backend logs "settings.no_auth_configured"). Plaintext, bcrypt-hashed at
# seed time; the `admin` name gets the admin role.
# MODULO_USERS=admin:change-me

# ---------------------------------------------------------------------------
# Redis - Settings.redis_url. NOT set means the compose default
# redis://redis:6379/0, i.e. the `redis` service in this compose file, which is
# correct for the bundled stack. Set it ONLY to point at an external/managed
# Redis (never leave it empty - the API refuses to boot when it resolves empty).
# ---------------------------------------------------------------------------
# REDIS_URL=redis://default:CHANGEME@host.upstash.io:6379

# ---------------------------------------------------------------------------
# License signing — the Ed25519 PRIVATE key (hex) used to SIGN enterprise
# license keys issued via the admin license-issue endpoint and the Stripe
# purchase fulfilment webhook. Keep in a vault; the public half goes in
# MODULO_LICENSE_PUBLIC_KEY (verified against on every license read).
# ---------------------------------------------------------------------------
# MODULO_LICENSE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Stripe — purchase fulfilment (FAR-178). Both keys must be set for the
# /api/v1/webhooks/stripe webhook to activate. Stripe-Signature verification
# uses STRIPE_WEBHOOK_SECRET; customer/customer_email lookups use
# STRIPE_SECRET_KEY.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Email — HITL email alerts AND the health watchdog's outage emails.
# The watchdog (deploy/watchdog/, carried by the root docker-compose.yml and
# by deploy/compose/docker-compose.prod.yml) monitors health by default and
# never sends mail until SMTP_HOST, SMTP_PORT, EMAIL_FROM and ALERT_EMAIL_TO
# are all set — monitoring-on/alerting-off without them is a supported state,
# not a misconfiguration (the container says which variables are missing and
# keeps probing). SMTP_USERNAME / SMTP_PASSWORD only if the server requires
# auth. One SMTP setup serves both the app's HITL emails and watchdog alerts.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=changeme
# EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_TO=ops@example.com, oncall@example.com

# ---------------------------------------------------------------------------
# SAQ (Celery removed in PR C) — plan F4 Settings section
# ---------------------------------------------------------------------------
# SAQ is the ONLY dispatch path post-cutover — dispatch_run always enqueues to
# SAQ and the dispatcher column always reads 'saq'. No enable flag.
# Claim staleness for SAQ runs.
# RUN_CLAIM_STALE_SECONDS=450
# Legacy claim window kept for the shared sync claim helpers.
# LEGACY_RUN_CLAIM_STALE_SECONDS=180
# SAQ job heartbeat knob.
# SAQ_JOB_HEARTBEAT=300
# DB heartbeat cadence (keep well below the 300s SAQ sweep threshold).
# RUN_HEARTBEAT_SECONDS=30
# Cutover hold gate — healthz/ready 503-gates when THIS machine's SAQ workers
# are stale (default true). Set false after the hold to relax to degraded.
# SAQ_HARD_GATE=true
# Web UI auth — FAIL-CLOSED (system worker refuses to boot without both).
# Provision via `fly secrets set` on all three Fly apps. SAQ_AUTH_USERNAME maps
# to the AUTH_USER env SAQ's web reads.
# REQUIRED by deploy/compose/docker-compose.prod.yml since FAR-1509: the SAQ
# system worker (which fires every cron/polling trigger) is fail-closed, so
# compose refuses to start until BOTH are set here rather than starting an API
# whose scheduler crash-loops. Pick your own user; generate the password:
#   SAQ_AUTH_PASSWORD=$(openssl rand -hex 24)
SAQ_AUTH_USERNAME=admin
SAQ_AUTH_PASSWORD=
# SAQ retries=N is N TOTAL attempts (N-1 retries).
# SAQ_RUN_RETRIES=5
# Deterministic fixed retry delay (retry_backoff=False).
# SAQ_RETRY_DELAY=60
# TEST-ONLY — refused outside test/staging (DEBUG=true).
# SAQ_TEST_PAUSE=false
# Sweep windows; re-enqueue is SAQ-only. Decoupled from RUN_CLAIM_STALE_SECONDS.
# SAQ_REENQUEUE_WINDOW=600
# SAQ_NEVER_DISPATCHED_WINDOW=300
# SAQ_WORKER_LOST_WINDOW=600
# SAQ worker Postgres pool size (per worker).
# Verified 2026-08-06: deployed Postgres max_connections=300, ~40 in use at
# sample time — 10 x 2 workers x up to 5 machines = 100 + web pools +
# checkpointer fits with headroom.
# SAQ_WORKER_DB_POOL_SIZE=10
# SAQ Redis client pool size (Upstash connection budget).
# Verified 2026-08-06: prod pins this to 5 (secret) with ~15 actual connected
# clients at sample time, so the old firefight default of 50 was over-provisioned.
# 20 caps at 200 potential conns across 5 machines; lower to 5 on a small tier.
# SAQ_REDIS_POOL_SIZE=20
# SAQ worker job concurrency, decoupled from Redis pool size.
# Design target 5/worker x up to 5 machines = up to 25 concurrent runs —
# verified-safe against the prod Postgres 300-connection cap.
# SAQ_WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Health checks — per-check timeout limits for /healthz/ready probes.
# Each per-check override falls back to the global value when set to 0.
# ---------------------------------------------------------------------------
# MODULO_HEALTH_TIMEOUT_SECONDS=5
# MODULO_HEALTH_DB_TIMEOUT_SECONDS=0
# MODULO_HEALTH_REDIS_TIMEOUT_SECONDS=0
# MODULO_HEALTH_CHECKPOINTER_TIMEOUT_SECONDS=0
# MODULO_HEALTH_MIGRATIONS_TIMEOUT_SECONDS=0
