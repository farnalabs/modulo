# Normalize line endings to LF in the repo; checkout as LF on all platforms.
# This prevents the LF↔CRLF churn that breaks diffs and pre-commit hooks.

* text=auto eol=lf

# Explicitly binary — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pyc binary

# Windows scripts get CRLF (only if added later)
*.bat text eol=crlf
*.cmd text eol=crlf
