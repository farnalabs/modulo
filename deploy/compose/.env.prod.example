# Production environment template for deploy/compose/docker-compose.prod.yml
# Copy to deploy/compose/.env and fill in every value.
# REQUIRED variables use the ${VAR:?message} syntax in the compose file -
# docker compose will refuse to start if any is missing.

# ─── Image pin ──────────────────────────────────────────────────────────────
# REQUIRED - no default. Set the exact Modulo version you intend to run.
# Example: TAG=v0.4.0
TAG=

# ─── Generated secrets ──────────────────────────────────────────────────────
# Generate each once and store securely. Do not reuse across environments.

# SECRET_KEY: 32+ random bytes (44 base64 chars). Rotation invalidates all JWT sessions.
# Generate: openssl rand -base64 32
SECRET_KEY=

# FERNET_KEY: 44-char urlsafe base64 (32 bytes decoded). Must be a REAL Fernet key.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# MODULO_DB_PASSWORD: Database password for the modulo, modulo_app, and modulo_system roles.
# Generate: openssl rand -base64 16
MODULO_DB_PASSWORD=

# SAQ_AUTH_USERNAME: SAQ web dashboard username (fail-closed if missing).
SAQ_AUTH_USERNAME=admin

# SAQ_AUTH_PASSWORD: SAQ web dashboard password (fail-closed if missing).
# Generate: openssl rand -base64 16
SAQ_AUTH_PASSWORD=

# ─── Optional / deployment-specific ─────────────────────────────────────────
# MODULO_PUBLIC_URL: Browser-facing base URL (SSO redirects, absolute links).
# MODULO_PUBLIC_URL=https://modulo.example.com

# REDIS_URL: External/managed Redis. Default = compose's internal redis service.
# REDIS_URL=redis://redis:6379/0

# MODULO_LOG_LEVEL: Log level (debug, info, warning, error).
# MODULO_LOG_LEVEL=info

# MODULO_LICENSE_KEY: License key for Team/Enterprise features.
# MODULO_LICENSE_KEY=

# SMTP for HITL alert email and watchdog.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# ALERT_EMAIL_TO=

# DB_CAPACITY_PATH: Mount point for the postgres_data volume (capacity monitor).
# DB_CAPACITY_PATH=/var/lib/modulo/db-volume

# SAQ_WORKER_DB_POOL_SIZE: Per-worker DB pool size (default 20, sized for SAQ_WORKER_CONCURRENCY=5).
# SAQ_WORKER_DB_POOL_SIZE=20
