# Environment template for the Modulo self-hosted production stack
# (docker-compose.prod.yml).
#
# DO NOT EDIT THIS FILE. Run the bundled `init-env.sh` once, which copies this
# template to `.env` and fills every REQUIRED value below with a freshly
# generated secret:
#
#     ./init-env.sh
#     docker compose up -d
#
# Compose reads `.env` from the project directory (the directory holding the
# compose file). Every REQUIRED value uses `${VAR:?...}` in the compose, so
# `docker compose up` refuses to start - naming the variable - until it is set.
# That fail-fast behaviour is deliberate: there is no default for a secret.

# ─── REQUIRED ───────────────────────────────────────────────────────────────

# Postgres password. Used by the `postgres` service and embedded in the app's
# DATABASE_URL / DATABASE_ADMIN_URL, so it must be the password the database was
# initialised with. Keep it URL-safe (hex or base64 without punctuation).
#   Generate: openssl rand -hex 24
MODULO_DB_PASSWORD=

# JWT signing secret (Settings.secret_key) - at least 32 random bytes.
#   Generate: openssl rand -base64 48
SECRET_KEY=

# Fernet key (Settings.fernet_key) encrypting stored connector and
# model-backend credentials. Must be 32 urlsafe-base64-encoded bytes; a hex
# string or a short value boots and then fails on first credential use.
#   Generate: openssl rand -base64 32
FERNET_KEY=

# SAQ worker web auth. The system worker (which fires every cron and polling
# trigger) fails closed without both, so compose refuses to start.
#   Generate the password: openssl rand -base64 24
SAQ_AUTH_USERNAME=admin
SAQ_AUTH_PASSWORD=

# ─── Optional ───────────────────────────────────────────────────────────────

# Host port the application is published on (default 80).
# PORT=80

# Browser-facing base URL (SSO redirects, absolute links).
# MODULO_PUBLIC_URL=http://localhost:80

# Log level: debug, info, warning, error.
# MODULO_LOG_LEVEL=info

# External/managed Redis. Unset means the bundled `redis` service.
# REDIS_URL=redis://redis:6379/0

# License key for Team/Enterprise features.
# MODULO_LICENSE_KEY=

# SMTP for HITL alert email and the health watchdog. Email stays disabled while
# SMTP_HOST is empty.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# ALERT_EMAIL_TO=
