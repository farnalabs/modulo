{
  "title": "Modulo Pipeline Performance",
  "uid": "modulo-pipeline-performance",
  "tags": ["modulo", "pipeline", "performance"],
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": { "type": "prometheus" }
      },
      {
        "name": "pipeline",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(modulo_runs_total, pipeline_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Run Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(modulo_pipeline_duration_seconds_bucket{span_name=\"pipeline.run\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(modulo_pipeline_duration_seconds_bucket{span_name=\"pipeline.run\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(modulo_pipeline_duration_seconds_bucket{span_name=\"pipeline.run\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "custom.lineWidth", "value": 3 }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "title": "Run Volume",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(modulo_runs_total{pipeline_name=~\"$pipeline\"}[$__interval])) by (pipeline_name)",
          "legendFormat": "{{pipeline_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "runs",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" }
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "title": "Error Rate by Pipeline",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(modulo_runs_total{pipeline_name=~\"$pipeline\", status=\"error\"}[$__rate_interval])) by (pipeline_name) / sum(rate(modulo_runs_total{pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (pipeline_name) * 100",
          "legendFormat": "{{pipeline_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "showLegend": true, "placement": "right" },
        "pieType": "pie",
        "reduceOptions": { "values": false, "calcs": ["mean"] }
      }
    },
    {
      "id": 4,
      "title": "Active Runs",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum(modulo_runs_active{pipeline_name=~\"$pipeline\"})",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 5,
      "title": "Run Duration by Pipeline",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(modulo_pipeline_duration_seconds_bucket{span_name=\"pipeline.run\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (le, pipeline_name))",
          "legendFormat": "p50",
          "format": "table"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(modulo_pipeline_duration_seconds_bucket{span_name=\"pipeline.run\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (le, pipeline_name))",
          "legendFormat": "p95",
          "format": "table"
        },
        {
          "expr": "sum(rate(modulo_pipeline_duration_seconds_count{span_name=\"pipeline.run\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (pipeline_name)",
          "legendFormat": "count",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "align": "left", "displayMode": "color-text", "minWidth": 100 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "count" },
            "properties": [
              { "id": "unit", "value": "runs" },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "fields": { "Time": { "type": "time" } }
          }
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "p95", "desc": true }],
        "footer": { "show": false },
        "showHeader": true
      }
    },
    {
      "id": 6,
      "title": "Slowest Nodes",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "topk(5, avg(rate(modulo_node_duration_seconds_sum{span_name=\"node.execute\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (node_name) / avg(rate(modulo_node_duration_seconds_count{span_name=\"node.execute\", pipeline_name=~\"$pipeline\"}[$__rate_interval])) by (node_name))",
          "legendFormat": "{{node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "barWidthFactor": 0.8 }
        }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 80,
        "showLegend": false,
        "sort": "desc"
      }
    }
  ]
}
