{
  "title": "Modulo Cost Tracking",
  "uid": "modulo-cost-tracking",
  "tags": ["modulo", "cost", "tracking"],
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": { "type": "prometheus" }
      },
      {
        "name": "org",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(modulo_cost_usd_total, cost_org_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "pipeline",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(modulo_cost_usd_total{cost_org_id=~\"$org\"}, cost_pipeline_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\"}, cost_model_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Spend by Org (Daily)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\"}[$__interval])) by (cost_org_id)",
          "legendFormat": "{{cost_org_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "title": "Spend by Model",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\"}[$__interval])) by (cost_model_id)",
          "legendFormat": "{{cost_model_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "USD" } },
      "options": {
        "displayLabels": ["name", "value", "percent"],
        "legend": { "showLegend": true, "placement": "right" },
        "pieType": "pie",
        "reduceOptions": { "values": false, "calcs": ["sum"] }
      }
    },
    {
      "id": 3,
      "title": "Spend by Pipeline",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\"}[$__interval])) by (cost_pipeline_id)",
          "legendFormat": "total_cost",
          "format": "table"
        },
        {
          "expr": "sum(increase(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\"}[$__interval])) by (cost_org_id, cost_pipeline_id)",
          "legendFormat": "by_org",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "custom": { "align": "left", "displayMode": "color-text", "minWidth": 120 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total_cost" },
            "properties": [
              { "id": "unit", "value": "USD" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 50 },
                { "color": "red", "value": 200 }
              ]}}
            ]
          }
        ]
      },
      "transformations": [],
      "options": {
        "sortBy": [{ "displayName": "total_cost", "desc": true }],
        "footer": { "show": false },
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Daily Spend Trend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\"}[$__interval]))",
          "legendFormat": "Total Spend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "showLegend": true, "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "title": "Estimated Monthly Total",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(modulo_cost_usd_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\"}[30d]))",
          "legendFormat": "Monthly"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "decimals": 2
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 6,
      "title": "Token Volume (Input vs Output)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(modulo_llm_tokens_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\", llm_type=\"input\"}[$__rate_interval]))",
          "legendFormat": "Input Tokens"
        },
        {
          "expr": "sum(rate(modulo_llm_tokens_total{cost_org_id=~\"$org\", cost_pipeline_id=~\"$pipeline\", cost_model_id=~\"$model\", llm_type=\"output\"}[$__rate_interval]))",
          "legendFormat": "Output Tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Input Tokens" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 15 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Output Tokens" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 25 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "placement": "bottom", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
