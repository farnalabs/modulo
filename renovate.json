{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos",
    "group:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "after 1am and before 7am"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency updates",
  "dependencyDashboardApproval": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "prHourlyLimit": 6,
  "prConcurrentLimit": 20,
  "branchConcurrentLimit": 20,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "npm",
    "pep621",
    "pre-commit"
  ],
  "packageRules": [
    {
      "description": "Group non-major updates by ecosystem",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "npm"
      ],
      "groupName": "JavaScript dependencies"
    },
    {
      "description": "Group non-major Python updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python dependencies"
    },
    {
      "description": "Group CI and development-tool updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchManagers": [
        "github-actions",
        "pre-commit"
      ],
      "groupName": "CI tooling"
    },
    {
      "description": "Automerge patch and digest updates after required checks",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "lockFileMaintenance"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep unstable dependencies under manual review",
      "matchCurrentVersion": "/^0/",
      "automerge": false
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "js-yaml v5 dropped YAML merge-key (<<) expansion — manifest tier/role gating depends on it",
      "matchPackageNames": [
        "js-yaml"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Hold Python below 3.15. python:3.15-slim breaks the prod image build: zstandard 0.25.0 ships no cp315 wheel, so 'uv sync --frozen' falls back to an sdist build that needs gcc, which the images' --no-build policy forbids (see revert #1721). The same cap must apply to backend/pyproject.toml's requires-python (pep621) - the Dockerfile base image must sit inside its range per tests/architecture/test_fly_toml_python_version.py - so match both the docker base image and the python-version datasource. Remove this once the native dependencies publish cp315 wheels.",
      "matchDatasources": [
        "docker",
        "python-version"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
