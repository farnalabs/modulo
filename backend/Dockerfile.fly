# syntax=docker/dockerfile:1.7
# Global build-arg declarations — required for --build-arg from fly deploy to
# be accepted without warnings.  Re-declared inside each stage that needs them.
ARG GIT_SHA
ARG GIT_BRANCH
ARG GIT_COMMIT_TIMESTAMP
ARG GIT_COMMIT_MESSAGE
ARG BUILD_TIMESTAMP
ARG CI_JOB_URL
ARG VITE_PRIMEUI_LICENSE

# =============================================================================
# Stage 1: Build frontend SPA
# =============================================================================
FROM node:22-alpine AS frontend-builder
WORKDIR /build

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc frontend/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    npm install -g --ignore-scripts pnpm@11.21.0 && pnpm install --frozen-lockfile --ignore-scripts && \
    if [ ! -f node_modules/reka-ui/dist/index.d.ts ] && [ -f node_modules/reka-ui/dist/index.d.cts ]; then \
        cp node_modules/reka-ui/dist/index.d.cts node_modules/reka-ui/dist/index.d.ts; \
    fi && \
    if [ ! -f node_modules/@internationalized/date/dist/index.mjs ] && [ -f node_modules/@internationalized/date/dist/index.js ]; then \
        cp node_modules/@internationalized/date/dist/index.js node_modules/@internationalized/date/dist/index.mjs; \
    fi

COPY frontend/ ./
ARG VITE_PRIMEUI_LICENSE
ENV VITE_PRIMEUI_LICENSE=${VITE_PRIMEUI_LICENSE}
RUN pnpm run build

# =============================================================================
# Stage 2: Backend + nginx for static serving
# =============================================================================
FROM python:3.12-slim
ENV PATH="/app/.venv/bin:$PATH" \
    UV_LINK_MODE=copy \
    HOME=/tmp

# Install nginx + uv (libcap2-bin provides setcap for non-root port binding)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
apt-get update && apt-get install -y --no-install-recommends libcap2-bin nginx
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --only-binary :all: uv==0.11.13

WORKDIR /app

# Backend dependencies + source
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra docker --extra redis --no-install-project
COPY backend/src/ src/
COPY backend/alembic.ini .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra docker --extra redis

# Volatile release metadata follows dependency installation so a new commit
# does not invalidate the expensive environment layers.
ARG GIT_SHA
ARG GIT_BRANCH
ARG GIT_COMMIT_TIMESTAMP
ARG GIT_COMMIT_MESSAGE
ARG BUILD_TIMESTAMP
ARG CI_JOB_URL
ENV GIT_SHA=$GIT_SHA \
    GIT_BRANCH=$GIT_BRANCH \
    GIT_COMMIT_TIMESTAMP=$GIT_COMMIT_TIMESTAMP \
    GIT_COMMIT_MESSAGE=$GIT_COMMIT_MESSAGE \
    BUILD_TIMESTAMP=$BUILD_TIMESTAMP \
    CI_JOB_URL=$CI_JOB_URL

# Frontend build output
COPY --from=frontend-builder /build/dist/ /usr/share/nginx/html/

# nginx config
COPY deploy/fly/nginx.conf /etc/nginx/conf.d/default.conf

# Scripts for seeding
COPY scripts/ /app/scripts/

# Entrypoint + bootstrap
COPY deploy/fly/entrypoint.sh /entrypoint.sh
COPY deploy/fly/release.sh /release.sh
COPY deploy/fly/bootstrap_db.py /app/deploy/fly/bootstrap_db.py
RUN chmod +x /entrypoint.sh
RUN chmod +x /release.sh

# Run as the unprivileged www-data user (docker:S6471). nginx binds the
# unprivileged port 8080, so setcap is applied for parity with the SPA image
# should the listen port ever drop below 1024. The entrypoint writes
# runtime-config.js into /usr/share/nginx/html at boot, hence the html chown.
# Debian nginx keeps proxy/body temp files under /var/lib/nginx (not
# /var/cache/nginx), so those dirs are pre-created and chowned for non-root.
RUN mkdir -p /var/cache/nginx /var/lib/nginx/body /var/lib/nginx/fastcgi /var/lib/nginx/proxy /var/lib/nginx/scgi /var/lib/nginx/uwsgi \
    && chown -R www-data:www-data /var/cache/nginx \
    && chown -R www-data:www-data /var/lib/nginx \
    && chown -R www-data:www-data /var/log/nginx \
    && chown -R www-data:www-data /usr/share/nginx/html \
    && touch /var/run/nginx.pid \
    && chown www-data:www-data /var/run/nginx.pid \
    && setcap 'cap_net_bind_service=+ep' "$(command -v nginx)"

USER www-data

EXPOSE 8000

CMD ["/entrypoint.sh"]
