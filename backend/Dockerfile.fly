# =============================================================================
# Stage 1: Build frontend SPA
# =============================================================================
FROM node:20-alpine AS frontend-builder
ARG VITE_AUTO_LOGIN_USERNAME
ARG VITE_AUTO_LOGIN_PASSWORD

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN VITE_AUTO_LOGIN_USERNAME=${VITE_AUTO_LOGIN_USERNAME} VITE_AUTO_LOGIN_PASSWORD=${VITE_AUTO_LOGIN_PASSWORD} npm run build

# =============================================================================
# Build-time metadata injected by deploy.ps1
# =============================================================================
ARG GIT_SHA
ARG GIT_BRANCH
ARG GIT_COMMIT_TIMESTAMP
ARG GIT_COMMIT_MESSAGE
ARG BUILD_TIMESTAMP
ARG CI_JOB_URL

# Persist build args as runtime env vars so /api/v1/deployment can serve them.
ENV GIT_SHA=$GIT_SHA
ENV GIT_BRANCH=$GIT_BRANCH
ENV GIT_COMMIT_TIMESTAMP=$GIT_COMMIT_TIMESTAMP
ENV GIT_COMMIT_MESSAGE=$GIT_COMMIT_MESSAGE
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP
ENV CI_JOB_URL=$CI_JOB_URL

# =============================================================================
# Stage 2: Backend + nginx for static serving
# =============================================================================
FROM python:3.12-slim

# Install nginx + uv
RUN apt-get update && apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir uv

WORKDIR /app

# Backend dependencies + source
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/src/ src/
COPY backend/alembic.ini .
RUN uv sync --frozen --no-dev --no-cache

# Frontend build output
COPY --from=frontend-builder /build/dist/ /usr/share/nginx/html/

# nginx config
COPY deploy/fly/nginx.conf /etc/nginx/conf.d/default.conf

# Scripts for seeding
COPY scripts/ /app/scripts/

# Entrypoint + bootstrap
COPY deploy/fly/entrypoint.sh /entrypoint.sh
COPY deploy/fly/bootstrap_db.py /app/deploy/fly/bootstrap_db.py
RUN chmod +x /entrypoint.sh

EXPOSE 8080

CMD ["/entrypoint.sh"]
