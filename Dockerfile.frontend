# syntax=docker/dockerfile:1.26
FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc frontend/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    npm install -g pnpm@11.21.0 --ignore-scripts && pnpm install --frozen-lockfile --ignore-scripts && \
    if [ ! -f node_modules/reka-ui/dist/index.d.ts ] && [ -f node_modules/reka-ui/dist/index.d.cts ]; then \
        cp node_modules/reka-ui/dist/index.d.cts node_modules/reka-ui/dist/index.d.ts; \
    fi && \
    if [ ! -f node_modules/@internationalized/date/dist/index.mjs ] && [ -f node_modules/@internationalized/date/dist/index.js ]; then \
        cp node_modules/@internationalized/date/dist/index.js node_modules/@internationalized/date/dist/index.mjs; \
    fi
COPY frontend/ ./
RUN pnpm run build

FROM nginx:alpine AS runtime
RUN apk add --no-cache ca-certificates libcap tzdata gettext
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
# Shared edge CSP snippet (FAR-447): template + default render + render script.
# render_csp.sh re-renders the snippet at boot so connect-src honours
# MODULO_MONITOR_DOMAINS (FAR-447 review Major-1). The render target must be
# owned by the runtime user (nginx) below: the entrypoint runs render_csp.sh
# under `set -e` as USER nginx, so a root-owned target makes the `>` redirect
# fail with EACCES and the container crash-loops before nginx starts.
COPY deploy/nginx/security_headers.conf.in /etc/nginx/security_headers.conf.in
COPY deploy/nginx/security_headers.conf /etc/nginx/security_headers.conf
COPY deploy/nginx/render_csp.sh /usr/local/bin/render_csp.sh
COPY deploy/nginx/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint.sh
RUN chmod +x /usr/local/bin/render_csp.sh /usr/local/bin/frontend-entrypoint.sh && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown nginx:nginx /usr/local/bin/render_csp.sh /usr/local/bin/frontend-entrypoint.sh && \
    chown nginx:nginx /etc/nginx/security_headers.conf /etc/nginx/security_headers.conf.in && \
    chown -R nginx:nginx /var/cache/nginx && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid && \
    setcap 'cap_net_bind_service=+ep' "$(command -v nginx)"
USER nginx
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/frontend-entrypoint.sh"]
