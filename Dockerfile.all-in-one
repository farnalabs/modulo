# Multi-stage build: frontend + backend → single image with nginx + uvicorn
FROM node:22-alpine AS frontend-builder
WORKDIR /app
    COPY frontend/package.json frontend/package-lock.json ./
    RUN npm ci --no-optional --ignore-scripts
    RUN cp node_modules/reka-ui/dist/index.d.cts node_modules/reka-ui/dist/index.d.ts
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor postgresql-client && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN pip install uv --no-cache-dir && uv sync --no-dev --frozen --no-cache
COPY backend/src ./src
COPY backend/alembic.ini ./alembic.ini
COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY deploy/nginx/all-in-one.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY deploy/supervisor/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
