# bundle-versions.env — shared version constants for the single-install bundle.
#
# Part of the single-install native distribution (ADR 031, FAR-670).
# Sourced by .github/workflows/bundle-release.yml (bundle build) and — in a
# later ticket — asserted against the docker-compose.yml image tags by a CI
# job, so the native install path and the Docker Compose path cannot silently
# drift apart (ADR 031, Decision 3 + Decision 11). Do not bump one without the
# other.
#
# Sourcing contract: plain `VAR=value` lines only, safe to `source` from bash
# and safe to parse line-by-line. No command substitution.
#
# Binary provenance rule (ADR 031, Decision 3): all bundled service binaries
# are glibc (Ubuntu/Debian-based) builds — NEVER alpine/musl extraction.
# Baseline for v1: Ubuntu 22.04 LTS (jammy), glibc 2.35. The bundle job runs on
# an ubuntu-22.04 runner so the Python venv, PostgreSQL build, and Redis build are
# all produced against glibc 2.35. The effective bundle floor is therefore glibc
# 2.35, covering every currently-supported Ubuntu LTS (22.04, 24.04), Debian 12+,
# and newer (FAR-2362).
#
# Every pinned artifact carries the sha256 of the exact file identified by its
# version string (computed from a fresh download at pin time). The bundle
# workflow re-verifies each download against these digests before extraction.

# ---------------------------------------------------------------------------
# python-build-standalone (CPython runtime)
#
# Pinned 2026-09-07 from:
#   https://github.com/astral-sh/python-build-standalone/releases/tag/20260901
# sha256 values are the matching lines of that release's SHA256SUMS asset.
# ---------------------------------------------------------------------------

PBS_RELEASE=20260901
PBS_CPYTHON_VERSION=3.12.14

PBS_AMD64_TARBALL=cpython-3.12.14+20260901-x86_64-unknown-linux-gnu-install_only.tar.gz
PBS_CPYTHON_AMD64_SHA256=936c246dfdbbfa7cb22dd01814a21f582a892689fae96b06071a5e433baffa22

PBS_ARM64_TARBALL=cpython-3.12.14+20260901-aarch64-unknown-linux-gnu-install_only.tar.gz
PBS_CPYTHON_ARM64_SHA256=b61b856c3e1a4fc65b8f6e6b0495ef975dd0924f90c59f3ea61b38a079173b84

# ---------------------------------------------------------------------------
# PostgreSQL 16 (server + client)
#
# Matches docker-compose.yml `postgres:16-alpine` (major 16; asserted in CI).
# Build from the pinned upstream source tarball on Ubuntu 22.04. PostgreSQL
# embeds its configured sharedir in the binaries, so distro packages are not
# relocatable: copying /usr/share/postgresql/16 into a bundle still leaves
# postgres looking at the host path. Configuring with the bundle prefix keeps
# postgres.bki, timezonesets, and the other runtime files inside pg/share.
# ---------------------------------------------------------------------------

PG_MAJOR=16
PG_VERSION=16.15
PG_SOURCE_URL=https://ftp.postgresql.org/pub/source/v16.15/postgresql-16.15.tar.gz
PG_SOURCE_SHA256=4f200ca23dfb120ff9838f13ce06014aad1d3c432d16ee9f93ab2000c0eeef7b
# Modulo requires no PostgreSQL contrib extensions. Keep this explicit so a
# future extension dependency must update the release build and its smoke test.
PG_REQUIRED_EXTENSIONS=

# ---------------------------------------------------------------------------
# Redis 8 (server + tools)
#
# Matches docker-compose.yml `redis:8-alpine` (major 8; asserted in CI).
# Compiled from the pinned upstream release tarball on the ubuntu-22.04 bundle
# runner so the shipped redis-server and redis-cli stay within the glibc 2.35
# floor (a Debian 13 deb would require glibc 2.41). Bundled unmodified under
# Redis' RSALv2 grant (ADR 031, Decision 3).
# ---------------------------------------------------------------------------

REDIS_MAJOR=8
REDIS_VERSION=8.0.2
REDIS_SOURCE_URL=https://download.redis.io/releases/redis-8.0.2.tar.gz
REDIS_SOURCE_SHA256=e9296b67b54c91befbcca046d67071c780a1f7c9f9e1ae5ed94773c3bb9b542f
