# bundle-versions.env — shared version constants for the single-install bundle.
#
# Part of the single-install native distribution (ADR 031, FAR-670).
# Sourced by .github/workflows/bundle-release.yml (bundle build) and — in a
# later ticket — asserted against the docker-compose.yml image tags by a CI
# job, so the native install path and the Docker Compose path cannot silently
# drift apart (ADR 031, Decision 3 + Decision 11). Do not bump one without the
# other.
#
# Sourcing contract: plain `VAR=value` lines only, safe to `source` from bash
# and safe to parse line-by-line. No command substitution.
#
# Binary provenance rule (ADR 031, Decision 3): all bundled service binaries
# are glibc (Debian-based) builds — NEVER alpine/musl extraction. Baseline for
# v1: Debian 13 (trixie), glibc 2.41. The venv is built on the ubuntu-24.04
# CI runner (glibc 2.39), so the effective bundle floor is glibc 2.41
# (Debian 13+, Ubuntu 26.04+). Widening the support envelope is packaging
# hardening tracked for the launcher/packaging tickets (FAR-671+).
#
# Every pinned artifact carries the sha256 of the exact file identified by its
# version string (computed from a fresh download at pin time). The bundle
# workflow re-verifies each download against these digests before extraction.

# ---------------------------------------------------------------------------
# python-build-standalone (CPython runtime)
#
# Pinned 2026-09-07 from:
#   https://github.com/astral-sh/python-build-standalone/releases/tag/20260901
# sha256 values are the matching lines of that release's SHA256SUMS asset.
# ---------------------------------------------------------------------------

PBS_RELEASE=20260901
PBS_CPYTHON_VERSION=3.12.14

PBS_AMD64_TARBALL=cpython-3.12.14+20260901-x86_64-unknown-linux-gnu-install_only.tar.gz
PBS_CPYTHON_AMD64_SHA256=936c246dfdbbfa7cb22dd01814a21f582a892689fae96b06071a5e433baffa22

PBS_ARM64_TARBALL=cpython-3.12.14+20260901-aarch64-unknown-linux-gnu-install_only.tar.gz
PBS_CPYTHON_ARM64_SHA256=b61b856c3e1a4fc65b8f6e6b0495ef975dd0924f90c59f3ea61b38a079173b84

# ---------------------------------------------------------------------------
# PostgreSQL 16 (server + client)
#
# Matches docker-compose.yml `postgres:16-alpine` (major 16; asserted in CI).
# Pinned 2026-09-07 from the PGDG pool (apt.postgresql.org — the official
# PostgreSQL packaging for Debian; plain Debian main does not carry PG 16 for
# every Debian release). Build target: Debian 13 (pgdg13).
# The client deb is pinned too: pg_dump (pre-upgrade snapshot, ADR 031
# Decision 7), pg_isready and psql all live in postgresql-client-16, not in
# the server deb.
# ---------------------------------------------------------------------------

PG_MAJOR=16
PG_VERSION=16.15
PG_DEB_VERSION=16.15-1.pgdg13+2
PG_POOL_BASE_URL=https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-16

PG_SERVER_AMD64_SHA256=89e7d4676954a496cd85ce1bae1e94af41a728a098a7043d46a38b704bb8c399
PG_CLIENT_AMD64_SHA256=82e1dfb1c8f6aed02811c43bff4ead374343ebafe61bca9af3662fc75a83a4b7
PG_SERVER_ARM64_SHA256=8032f96e02418eaaf90a7c2938d93b3ba1788f8228d2450e6302d65d6fcc4e2e
PG_CLIENT_ARM64_SHA256=98f1b6ea41235282173901ef49dfb7b4c254810e9e23a2f2b3aeb758aedd2604

# ---------------------------------------------------------------------------
# Redis 8 (server + tools)
#
# Matches docker-compose.yml `redis:8-alpine` (major 8; asserted in CI).
# Pinned 2026-09-07 from Debian 13 (trixie) main:
#   https://deb.debian.org/debian/pool/main/r/redis/
# Debian 12 (bookworm) carries only Redis 7 and packages.redis.io does not
# permit pool listing, so trixie is the pinned source. Bundled unmodified
# under Redis' RSALv2 grant (ADR 031, Decision 3).
# redis-tools is pinned because redis-cli (health checks / doctor) ships in
# it, separate from redis-server.
# ---------------------------------------------------------------------------

REDIS_MAJOR=8
REDIS_VERSION=8.0.2
REDIS_DEB_VERSION=8.0.2-3+deb13u2
REDIS_POOL_BASE_URL=https://deb.debian.org/debian/pool/main/r/redis

REDIS_SERVER_AMD64_SHA256=0edc72458f66c68f2d4ccd0c9959a85a81f4ec7de410a28861cde4a2059f245c
REDIS_TOOLS_AMD64_SHA256=9d7cbe20963c8bfc00af3e8a3a33451bb815f7501b12e55583f9e942a767859b
REDIS_SERVER_ARM64_SHA256=04126c542ddefbb60070bbad420228d699b2f7515e5ba20e4cd9247ac6885691
REDIS_TOOLS_ARM64_SHA256=207fae4f71895f142c99f06a19bd4b26c4a7aabb8615e82128181c9cebe6a7b0
