# bundle-versions-windows.env — Windows native artifact pins for the single-install bundle.
#
# Part of the single-install native distribution (ADR 031, FAR-670).
# Sourced by .github/workflows/windows-artifacts.yml (artifact download/verify)
# and the Windows installer build workflow.
#
# Sourcing contract: plain `VAR=value` lines only, safe to `source` from bash
# and safe to parse line-by-line. No command substitution.
#
# Binary provenance rule (ADR 031, Decision 3): all bundled service binaries
# are official upstream builds where available. For Valkey, the upstream project
# does not yet publish Windows MSVC binaries; we use the community-maintained
# MSVC build from SamuelMarks/valkey-windows (built from official Valkey source).
# Every pinned artifact carries the sha256 of the exact file identified by its
# version string (computed from a fresh download at pin time). The workflow
# re-verifies each download against these digests before extraction.
#
# Last updated: 2026-11-02

# ---------------------------------------------------------------------------
# Valkey 9.1.x (server + CLI)
#
# Upstream Valkey (valkey-io/valkey) does not publish Windows MSVC binaries.
# We use the community MSVC build from SamuelMarks/valkey-windows, which builds
# from the official Valkey source tags. Pinned to Valkey 9.1.3 (latest stable
# as of 2026-10-26, security release).
# Source: https://github.com/SamuelMarks/valkey-windows/releases/tag/9.1.3
# Upstream tag: https://github.com/valkey-io/valkey/releases/tag/9.1.3
# ---------------------------------------------------------------------------

VALKEY_VERSION=9.1.3
VALKEY_ZIP_URL=https://github.com/SamuelMarks/valkey-windows/releases/download/9.1.3/Valkey-9.1.3-win64.zip
VALKEY_ZIP_SHA256=ea44972a994e468049426ab1e2285d458ad49dae718b6c014a28417e7ea790a7

# Individual binary names inside the zip (for verification)
VALKEY_SERVER_EXE=valkey-server.exe
VALKEY_CLI_EXE=valkey-cli.exe

# ---------------------------------------------------------------------------
# python-build-standalone (CPython runtime) — Windows x64 MSVC
#
# Pinned from astral-sh/python-build-standalone release 20260901 (matching
# the Linux bundle's PBS_RELEASE for version parity). CPython 3.12.14.
# The install_only tarball contains the full standard library and pip.
# Source: https://github.com/astral-sh/python-build-standalone/releases/tag/20260901
# SHA256 from the release's SHA256SUMS asset.
# ---------------------------------------------------------------------------

PBS_RELEASE=20260901
PBS_CPYTHON_VERSION=3.12.14
PBS_WIN_X64_TARBALL=cpython-3.12.14+20260901-x86_64-pc-windows-msvc-install_only.tar.gz
PBS_WIN_X64_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260901/cpython-3.12.14%2B20260901-x86_64-pc-windows-msvc-install_only.tar.gz
PBS_WIN_X64_SHA256=e90c1b6419da3bd812dd73bb3de40287a21abf153438147639ec5e20375ea93f

# ---------------------------------------------------------------------------
# PostgreSQL 16 (server + client binaries) — Windows x64 EDB build
#
# Matches docker-compose.yml `postgres:16-alpine` (major 16; asserted in CI).
# Pinned to EDB's Windows x64 binary zip for PostgreSQL 16.15 (fileid 1260623).
# This zip contains the complete bin/ directory with postgres, pg_ctl, pg_dump,
# pg_isready, psql, and all client libraries.
# Source: https://www.enterprisedb.com/download-postgresql-binaries (Version 16.15)
# Direct: https://get.enterprisedb.com/postgresql/postgresql-16.15-5-windows-x64-binaries.zip
# ---------------------------------------------------------------------------

PG_MAJOR=16
PG_VERSION=16.15
PG_WIN_X64_ZIP_URL=https://get.enterprisedb.com/postgresql/postgresql-16.15-5-windows-x64-binaries.zip
PG_WIN_X64_ZIP_SHA256=43bb45f173a6f08cf1d29a97a6d8deb119e8e8093a24c00d2d1001a0ccaa8281

# Expected binary names inside pgsql/bin/ (for verification)
PG_SERVER_EXE=postgres.exe
PG_CTL_EXE=pg_ctl.exe
PG_DUMP_EXE=pg_dump.exe
PG_ISREADY_EXE=pg_isready.exe
PG_PSQL_EXE=psql.exe
