{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modulo.run/schemas/windows-bundle-manifest.schema.json",
  "title": "Modulo Windows native bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "architecture", "launcher", "frontend", "native_requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "architecture": {"const": "amd64"},
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entry_point", "start_command"],
      "properties": {
        "path": {"const": "modulo.exe"},
        "entry_point": {"const": "modulo.cli.main:cli"},
        "start_command": {"const": "modulo start"}
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dist_path"],
      "properties": {"dist_path": {"const": "frontend-dist"}}
    },
    "native_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresql", "redis"],
      "properties": {
        "postgresql": {"$ref": "#/$defs/native_requirement"},
        "redis": {"$ref": "#/$defs/native_requirement"}
      }
    }
  },
  "$defs": {
    "native_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "relative_path", "binaries"],
      "properties": {
        "required": {"const": true},
        "relative_path": {"type": "string", "minLength": 1},
        "binaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
