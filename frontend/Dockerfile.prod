# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    npm install -g pnpm@11.21.0 --ignore-scripts && pnpm install --frozen-lockfile --ignore-scripts && \
    if [ ! -f node_modules/@internationalized/date/dist/index.mjs ] && [ -f node_modules/@internationalized/date/dist/index.js ]; then \
        cp node_modules/@internationalized/date/dist/index.js node_modules/@internationalized/date/dist/index.mjs; \
    fi
# S6470: copy only the sources needed to build instead of `COPY . .`
COPY index.html vite.config.ts tsconfig.json tsconfig.node.json tailwind.config.cjs components.json eslint.config.mjs .npmrc .nsprc ./
COPY src ./src
COPY public ./public
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
ARG VITE_MONITOR_BACKEND="builtin,sentry,datadog-rum,grafana-faro"
ENV VITE_MONITOR_BACKEND=${VITE_MONITOR_BACKEND}
ARG VITE_SENTRY_DSN=""
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
# NOSONAR (S6472): VITE_-prefixed vars are inlined into the public client bundle by
# design, so these are NOT server secrets. VITE_DATADOG_RUM_CLIENT_TOKEN is a
# Datadog RUM *client* token (public by design — safe to ship to browsers, unlike
# the RUM API key), and VITE_GRAFANA_FARO_URL is a public collector endpoint URL.
# Keeping them as build ARGs/ENV is the only way Vite can inline them at build time;
# a build secret would still end up in the shipped JS, so it adds no protection here.
ARG VITE_DATADOG_RUM_CLIENT_TOKEN=""
ENV VITE_DATADOG_RUM_CLIENT_TOKEN=${VITE_DATADOG_RUM_CLIENT_TOKEN}
ARG VITE_GRAFANA_FARO_URL=""
ENV VITE_GRAFANA_FARO_URL=${VITE_GRAFANA_FARO_URL}
RUN pnpm run build

FROM nginx:alpine
RUN apk add --no-cache ca-certificates libcap tzdata
COPY --from=build /app/dist /usr/share/nginx/html
RUN rm /etc/nginx/conf.d/default.conf
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF
RUN chown -R nginx:nginx /var/cache/nginx && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid && \
    setcap 'cap_net_bind_service=+ep' "$(command -v nginx)"
USER nginx
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
