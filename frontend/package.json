{
    "name": "modulo-frontend",
    "version": "0.3.288",
    "private": true,
    "scripts": {
        "generate:api": "powershell -ExecutionPolicy Bypass -File scripts/generate-api-types.ps1",
        "dev": "vite",
        "build": "vite build",
        "test:e2e": "playwright test",
        "test:e2e:staging": "cross-env E2E_TARGET=staging E2E_NO_WEBSERVER=true playwright test",
        "test:e2e:app": "cross-env E2E_TARGET=app E2E_NO_WEBSERVER=true playwright test",
        "test:e2e:coverage": "cross-env VITE_COVERAGE=true playwright test",
        "test:all": "npm run test:unit && npm run test:e2e:smoke",
        "test:e2e:smoke": "playwright test --grep \"@smoke\"",
        "test:unit": "vitest run src",
        "preview": "vite preview",
        "lint": "eslint \"src/**/*.{vue,ts,js}\"",
        "test:contrast": "playwright test wcag-contrast",
        "lint:fix": "npm run lint -- --fix",
        "type-check": "vue-tsc --noEmit",
        "postinstall": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/reka-ui-patch.ps1 && powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/internationalized-date-patch.ps1"
    },
    "optionalDependencies": {
        "@sentry/vue": "^8.0.0"
    },
    "dependencies": {
        "@lucide/vue": "^1.21.0",
        "@tanstack/vue-query": "^5.101.2",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/controls": "^1.1.3",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "pinia": "^3.0.4",
        "radix-vue": "^1.9.0",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^2.6.1",
        "vue": "^3.4.0",
        "vue-i18n": "^11.4.6",
        "vue-router": "^4.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@intlify/unplugin-vue-i18n": "^6.0.8",
        "@playwright/test": "^1.61.1",
        "@rolldown/binding-win32-x64-msvc": "^1.1.5",
        "@rollup/plugin-yaml": "^5.0.0",
        "@rushstack/eslint-patch": "^1.16.1",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-typescript": "^13.0.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.5.0",
        "cross-env": "^10.1.0",
        "eslint": "^8.57.0",
        "eslint-plugin-no-secrets": "^2.3.3",
        "eslint-plugin-vue": "^9.24.0",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-instrument": "^6.0.3",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-reports": "^3.2.0",
        "jsdom": "^26.1.0",
        "magic-string": "^0.30.21",
        "openapi-fetch": "^0.17.0",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.15",
        "rollup": "^4.62.2",
        "shadcn-vue": "^2.7.4",
        "tailwindcss": "^3.4.19",
        "typescript": "~5.4.0",
        "v8-to-istanbul": "^9.3.0",
        "vite": "^8.0.16",
        "vitest": "^3.2.4",
        "vue-tsc": "^2.0.0"
    },
    "overrides": {
        "esbuild": ">=0.28.1"
    }
}
