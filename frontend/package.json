{
    "name": "modulo-frontend",
    "version": "0.3.323",
    "private": true,
    "scripts": {
        "generate:api": "uv run --project ../backend --no-sync python ../scripts/run_generate_api_types.py",
        "dev": "vite",
        "build": "vite build",
        "test:e2e": "playwright test",
        "test:e2e:staging": "cross-env E2E_TARGET=staging E2E_NO_WEBSERVER=true playwright test",
        "test:e2e:app": "cross-env E2E_TARGET=app E2E_NO_WEBSERVER=true playwright test",
        "test:e2e:coverage": "cross-env VITE_COVERAGE=true playwright test",
        "test:all": "npm run test:unit && npm run test:e2e:smoke",
        "test:e2e:smoke": "playwright test --grep \"@smoke\"",
        "test:e2e:mobile": "playwright test tests/e2e/mobile-layout.spec.ts --workers=1",
        "test:mutation": "stryker run",
        "test:unit": "vitest run src --pool=threads --maxWorkers=4",
        "preview": "vite preview",
        "lint": "eslint src --cache --cache-location .cache/eslint",
        "test:contrast": "playwright test wcag-contrast",
        "lint:fix": "npm run lint -- --fix",
        "type-check": "vue-tsc --noEmit",
        "postinstall": "node scripts/internationalized-date-patch.cjs"
    },
    "optionalDependencies": {
        "@datadog/browser-logs": "^7.5.0",
        "@datadog/browser-rum": "^7.5.0",
        "@grafana/faro-web-sdk": "^2.8.2"
    },
    "dependencies": {
        "@lucide/vue": "^1.21.0",
        "@primeuix/styled": "^1.0.0",
        "@primeuix/themes": "^3.0.0",
        "@sentry/vue": "^10.65.0",
        "@tanstack/vue-query": "^5.101.2",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/controls": "^1.1.3",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "echarts": "^6.1.0",
        "overlayscrollbars": "^2.12.0",
        "overlayscrollbars-vue": "^0.5.10",
        "pinia": "^2.1.7",
        "primevue": "^5.0.1",
        "tailwind-merge": "^2.6.1",
        "vue": "^3.4.0",
        "vue-echarts": "^8.0.1",
        "vue-i18n": "^11.4.6",
        "vue-json-pretty": "2.6.0",
        "vue-router": "^4.3.0",
        "vuedraggable": "^4.1.0",
        "web-vitals": "4.2.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.61.1",
        "@rollup/plugin-yaml": "^5.0.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.5.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.2",
        "eslint-plugin-vue": "^10.9.2",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-instrument": "^6.0.3",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-reports": "^3.2.0",
        "js-yaml": "^4.3.0",
        "jsdom": "^29.1.1",
        "magic-string": "^1.0.0",
        "openapi-fetch": "^0.17.0",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.15",
        "rollup": "^4.62.2",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.9.0",
        "v8-to-istanbul": "^9.3.0",
        "vite": "^8.1.4",
        "vitest": "^3.2.4",
        "vue-tsc": "^3.3.7"
    },
    "packageManager": "pnpm@11.25.0"
}
